# The phone's live cell (cell a, ADR-015): the banks. Settings only; secrets are in secrets.env (never committed).
CARDRAIL_WATCH=true
CARDRAIL_CELL=a
CARDRAIL_STATE_FILE=/data/data/com.termux/files/home/cardrail/cell-state
SPROUT_STATUS_FILE=/data/data/com.termux/files/home/sprout/cells/status.json
LAPTOP_LAN=192.168.0.103
CARDRAIL_PEER_LAN=192.168.0.103
CARDRAIL_PEER_STATUS_URL=http://192.168.0.103:8209/cell/status
CARDRAIL_PG_PORT=5432
CARDRAIL_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail
# the laptop's Postgres, for the subscription: through the TCP path Sprout's cells already keep (agreed with Sprout)
CARDRAIL_PEER_DB_URL=jdbc:postgresql://127.0.0.1:15433/cardrail
# the banks alone; holding the laptop's half too, start.sh gives the whole system HOLDING_XMX
XMX=96m
HOLDING_XMX=176m
LOG_FORMAT=ecs
DB_POOL_SIZE=2
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT=10000
CARDRAIL_DEMO=true
TRACE_URL=http://192.168.0.103:8206
ISSUER_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=issuer
MERIDIAN_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=meridian
TRACE_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=trace
NETWORK_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=network
ACQUIRER_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=acquirer
VAULT_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=vault
GATEWAY_DB_URL=jdbc:postgresql://127.0.0.1:5432/cardrail?currentSchema=gateway
# what the laptop's half calls here: Kestrel Bank (HTTP and ISO 8583), Meridian (both), and the cell status
ISSUER_BIND=0.0.0.0
ISSUER_ISO_BIND=0.0.0.0
MERIDIAN_BIND=0.0.0.0
MERIDIAN_ISO_BIND=0.0.0.0
CARDRAIL_STATUS_BIND=0.0.0.0
# the rails, on the laptop (while this cell holds them, the host points these here instead)
ISSUER_NETWORK_URL=http://192.168.0.103:8204
MERIDIAN_GATEWAY_URL=http://192.168.0.103:8201
